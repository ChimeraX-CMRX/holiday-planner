# Address to listen on. Use 127.0.0.1 behind a reverse proxy.
HOLIDAY_HOST=0.0.0.0

# Any unused TCP port from 1 to 65535.
HOLIDAY_PORT=7070

# Writable storage locations for the service user.
HOLIDAY_DB_PATH=/opt/holiday-planner/data/holiday-planner.sqlite3
HOLIDAY_TILE_CACHE=/opt/holiday-planner/data/tile-cache
